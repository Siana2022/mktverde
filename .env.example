# ─────────────────────────────────────────────────────────────────────────────
# Panel Verde Esmeralda — variables de entorno
#
# Copia este archivo a .env.local (desarrollo) y configura las mismas variables
# en Vercel (Project → Settings → Environment Variables) para producción.
#
# SIN estas credenciales la app funciona igualmente, mostrando el SNAPSHOT de
# datos reales incluido en data/snapshot.json (fechado). Al rellenarlas, la app
# pasa automáticamente a leer datos EN VIVO.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify (Admin API) ──
# Dominio interno de la tienda (.myshopify.com).
SHOPIFY_STORE_DOMAIN=q2ugmg-bz.myshopify.com
SHOPIFY_API_VERSION=2025-10
#
# Opción A (recomendada para apps del Dev Dashboard, "client credentials"):
# en la app → Settings → Credentials, copia Client ID y Client secret. El panel
# pide el token él solo (válido 24 h) y lo renueva. Requiere la app instalada en
# la tienda y con scopes read_orders, read_products.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
#
# Opción B (apps antiguas con token fijo): "Admin API access token" (shpat_...).
# Si se rellena, tiene prioridad sobre A.
SHOPIFY_ADMIN_TOKEN=

# ── Google Ads API ──
# Necesitas: developer token (del MCC), un OAuth client (client_id + secret) y
# un refresh_token con acceso a la cuenta. login_customer_id = la MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=2333383997
GOOGLE_ADS_CUSTOMER_ID=7701012791

# ── Zona horaria del negocio (para "hoy" e intradía) ──
PANEL_TIMEZONE=Europe/Madrid

# ── MCP remoto (conector de claude.ai) ──
# Secreto que forma parte de la URL del conector: /api/mcp/<MCP_SECRET>.
# Genera uno largo y aleatorio, p. ej.: openssl rand -hex 24
# Sin esta variable, el endpoint MCP responde 404 (cerrado).
MCP_SECRET=

# ── Meta Ads (Marketing API, directo — sin intermediarios) ──
# Token de System User de Meta Business con permiso ads_read (largo plazo) y el id
# de la cuenta publicitaria. Sin esto, Meta sale como "pendiente".
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
META_API_VERSION=v23.0

# ── Fase 2 (aún sin conector): Amazon ──
# AMAZON_SPAPI_REFRESH_TOKEN=
# AMAZON_ADS_REFRESH_TOKEN=
